/* ============ RELEASE NOTES - CONTENT ============ */
"release_notes_2_10_0_1" = "Protected card saving after a group loading error: retry loading without losing entered text";
"release_notes_2_10_0_2" = "Added an import preview, data validation and merging of duplicate groups and cards; failed imports no longer leave partially imported data";
"release_notes_2_10_0_3" = "Fixed the daily new-word limit, SRS queue order and session recovery; the first answer counts toward the limit even when incorrect";
"release_notes_2_10_0_4" = "Fixed calendar-based review scheduling and the next-session forecast across local dates and time zone changes";
"release_notes_2_10_0_5" = "Fixed explanation display on the back of SRS cards";
"release_notes_2_10_0_6" = "Fixed daily progress, the activity calendar and streaks: goal changes apply today, previous days stay unchanged, and days with no SRS tasks count as completed";
"release_notes_2_10_0_7" = "Clarified correct-answer counter labels and fixed achievement awards and sequential display of multiple rewards";
"release_notes_2_10_0_8" = "The widget updates after data is saved and indicates stale or unavailable data; fixed opening SRS from the widget while the app is running, closed or completing first-time setup";
"release_notes_2_10_0_9" = "Added optional reminders in Settings with a time picker and permission status; notification permission is requested only after a user action";
"release_notes_2_10_0_10" = "Reminders are recalculated from the current SRS queue; the widget follows the selected app language and theme";

"release_notes_2_9_0_1" = "Added data backup and restore via the Files app";
"release_notes_2_9_0_2" = "Added reverse card mode (learning from translation to word)";
"release_notes_2_9_0_3" = "Added local notifications to remind you about due SRS cards";
"release_notes_2_9_0_4" = "App now automatically selects English or Russian based on system language";
"release_notes_2_9_0_5" = "Improved SRS session results screen with detailed statistics and next review info";

"release_notes_2_8_0_1" = "Added reverse card mode (learning from translation to original word)";
