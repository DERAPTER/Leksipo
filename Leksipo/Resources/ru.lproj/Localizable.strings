/* ============ RELEASE NOTES - CONTENT ============ */
"release_notes_2_10_0_1" = "Защищено сохранение карточки после ошибки загрузки групп: добавлен повтор загрузки с сохранением введённого текста";
"release_notes_2_10_0_2" = "Добавлены предварительный просмотр импорта, проверка данных и объединение повторяющихся групп и карточек; ошибка больше не оставляет частичный импорт";
"release_notes_2_10_0_3" = "Исправлены дневной лимит новых слов, порядок и восстановление очереди SRS; первое знакомство со словом учитывается даже при неправильном ответе";
"release_notes_2_10_0_4" = "Исправлены календарные правила повторений и прогноз следующей тренировки с учётом местного времени и смены часового пояса";
"release_notes_2_10_0_5" = "Исправлено отображение пояснения на обороте карточки SRS";
"release_notes_2_10_0_6" = "Исправлены дневной прогресс, календарь и серии: новая цель применяется сегодня, прошлые дни сохраняются, дни без заданий SRS засчитываются выполненными";
"release_notes_2_10_0_7" = "Уточнены подписи счётчика правильных ответов и исправлены выдача достижений и последовательный показ нескольких наград";
"release_notes_2_10_0_8" = "Виджет обновляется после сохранения данных и показывает, когда данные устарели или недоступны; исправлен переход в SRS при открытом и закрытом приложении и после первого запуска";
"release_notes_2_10_0_9" = "Добавлены включение напоминаний в настройках, выбор времени и статус системного разрешения; запрос разрешения появляется только по действию пользователя";
"release_notes_2_10_0_10" = "Напоминания пересчитываются по актуальной очереди SRS; виджет учитывает выбранные язык и тему приложения";

"release_notes_2_9_0_1" = "Добавлена возможность резервного копирования и восстановления данных через приложение «Файлы»";
"release_notes_2_9_0_2" = "Добавлен обратный режим карточек (изучение с перевода на оригинал)";
"release_notes_2_9_0_3" = "Добавлены локальные уведомления с напоминанием о карточках SRS";
"release_notes_2_9_0_4" = "При первом запуске приложение автоматически выбирает язык системы (английский или русский)";
"release_notes_2_9_0_5" = "Улучшен экран результатов SRS-сессии с детальной статистикой и информацией о следующем повторении";

"release_notes_2_8_0_1" = "Добавлен обратный режим карточек (изучение с перевода на оригинал)";
